# Copy to .env and fill in locally. Never commit .env.
# Values below are intentionally empty.

# LLM provider key (OpenAI)
OPENAI_API_KEY=

# Serper (Google search API) key
SERPER_API_KEY=

# Exact API model identifier to use. Verified against your account by:
#   python -m launchscout.model_check
MODEL_NAME=

# Deployment mode. Fails closed: anything except the exact value "live" runs the app in
# public demo mode (saved runs only; research, model, search, scrape and deck generation are
# disabled and no keys are needed). Set LAUNCHSCOUT_MODE=live ONLY on a trusted local machine.
LAUNCHSCOUT_MODE=
# Optional: directory of saved runs to browse (the demo image sets this).
LAUNCHSCOUT_RUNS_DIR=
